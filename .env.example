# Export these variables in your shell; this file is documentation, not auto-loaded.
# Use groq for hosted text generation; vision and embeddings remain independent.
CHAT_PROVIDER=ollama
EMBEDDING_PROVIDER=ollama
VISION_PROVIDER=ollama
TRANSCRIPTION_PROVIDER=whisper_cpp
PDF_PROVIDER=poppler
VIDEO_PROVIDER=ffmpeg
CHAT_MODEL=gemma3:4b
VISION_MODEL=gemma3:4b
EMBEDDING_MODEL=nomic-embed-text:latest
WHISPER_MODEL=data/models/ggml-small.bin
WHISPER_CLI=whisper-cli
WHISPER_LANGUAGE=auto
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe
PDFINFO_BIN=pdfinfo
PDFTOTEXT_BIN=pdftotext
PDFTOPPM_BIN=pdftoppm
VIDEO_SAMPLE_FRAMES=3
OLLAMA_URL=http://127.0.0.1:11434
PORT=3730
DATABASE_PATH=data/rag.sqlite


# For CHAT_PROVIDER=groq, use CHAT_MODEL=openai/gpt-oss-20b.
# Supply GROQ_API_KEY securely through scripts/setup.py or GROQ_API_KEY_FILE.
BIND_ADDRESS=127.0.0.1
# Docker: use host.docker.internal for host Ollama, or ollama for Compose.
ORDO_IMAGE=kaw393939/is373-rust-rag:latest

# Optional authenticated mode (production requires HTTPS and AUTH_MODE=required):
AUTH_MODE=local
# APP_ENV=production
# APP_ORIGIN=https://ordo.example.edu
# Hosted independent roles:
# VISION_PROVIDER=groq
# VISION_MODEL=qwen/qwen3.8-27b
# VISION_MAX_IMAGES=2
# TRANSCRIPTION_PROVIDER=groq
# TRANSCRIPTION_MODEL=whisper-large-v3-turbo
# EMBEDDING_PROVIDER=fastembed
# EMBEDDING_URL=http://embeddings:8080
# ATTACHMENT_QUOTA_MB=100
# See deploy/compose.production.yaml and docs/course/production.md.
